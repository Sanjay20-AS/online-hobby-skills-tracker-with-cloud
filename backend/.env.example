# Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER expose service-role keys to the frontend.

# Application settings
APP_ENV=development
APP_NAME=Online Hobby and Skills Tracker
API_V1_PREFIX=/api/v1

# Database connection string (Supabase PostgreSQL)
DATABASE_URL=YOUR_DATABASE_CONNECTION_STRING

# Supabase project URL (from your Supabase project dashboard)
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# Supabase anonymous / publishable key
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Allowed CORS origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173
